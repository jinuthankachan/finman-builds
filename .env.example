# Copy this file to .env, next to compose.yaml, to change a setting. Every value is optional.

# The release to run, e.g. 1.2.3 (without the v). Empty means the newest one.
#FINMAN_VERSION=

# The database. Set these before the first `docker compose up`: PostgreSQL applies them only when
# it creates its data volume. It is reachable from the app container only.
#POSTGRES_USER=invest
#POSTGRES_PASSWORD=invest
#POSTGRES_DB=invest

# Where the app answers. APP_BIND=0.0.0.0 publishes it to your network too; the app then also
# needs allow_lan = true under [server] in its /data/config.toml (see the README).
#APP_BIND=127.0.0.1
#APP_PORT=8790

# API keys for the AI services (the container has no AI command-line tools). Keys typed on the
# Settings page win.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=

# API addresses (Settings > AI access wins). A server on this computer is host.docker.internal
# from inside the container, e.g. an OpenAI-compatible one on port 4000:
#OPENAI_BASE_URL=http://host.docker.internal:4000/v1
#ANTHROPIC_BASE_URL=
#GOOGLE_GEMINI_BASE_URL=
